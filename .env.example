# MarketLens configuration. Copy to .env. NEVER commit real keys.
# MOCK = synthetic data (always clearly labelled); LIVE = real providers only (missing data stays MISSING).
MARKETLENS_MODE=MOCK

# --- LIVE data providers (leave empty to disable; the feature is then shown as MISSING) ---
SEC_USER_AGENT=            # required by SEC EDGAR, e.g. "MarketLens yourname@example.com"
FINNHUB_API_KEY=           # quotes, company news, earnings calendar/history
POLYGON_API_KEY=           # daily bars (grouped daily for the whole market)
FRED_API_KEY=              # macro (Fed/Treasury/BLS/BEA via FRED)

# --- AI committee (optional; everything deterministic works without it) ---
LLM_PROVIDER=mock          # mock (MOCK mode only) | anthropic | openai | openai_compatible | none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # or a local server (Ollama / LM Studio) / Gemini OpenAI endpoint
FAST_MODEL=claude-haiku-4-5
DEEP_MODEL=claude-opus-5
AI_COMMITTEE_TOP_N=20

# --- runtime ---
ENABLE_PAPER_TRADING=true
ENABLE_AI_COMMITTEE=true
MARKETLENS_SCHEDULER=false
SCAN_INTERVAL_MINUTES=60
# MARKETLENS_DATA_DIR=     # default: ./data (dev) or %LOCALAPPDATA%\MarketLens (packaged)
# MARKETLENS_DATABASE_URL= # default SQLite; e.g. postgresql+psycopg://user:pass@host/marketlens
LOG_LEVEL=INFO
