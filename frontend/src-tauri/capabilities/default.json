{
  "identifier": "default",
  "description": "The UI talks to the local backend over HTTP only; no shell access from the webview.",
  "windows": ["main"],
  "permissions": ["core:default", {
    "identifier": "opener:allow-open-url",
    "allow": [{ "url": "https://*" }, { "url": "http://127.0.0.1:*/*" }, { "url": "http://localhost:*/*" }]
  }]
}
